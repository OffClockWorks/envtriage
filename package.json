    "envtriage": "bin/envtriage.js"
  },
  "main": "lib/index.js",
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "test",
    "examples"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dotenv",
    "env",
    "lint",
    "cli",
    "ci"
  ],
  "author": "Off Clock Works (Hot Box Holdings LLC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OffClockWorks/envtriage.git"
  },
  "homepage": "https://github.com/OffClockWorks/envtriage#readme",
